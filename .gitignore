# Environment variables
.env
.env.*
!.env.example

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Packaged release builds (large binaries, rebuilt by `make dist-mac`)
/dist/

# Flutter run logs
flutter_*.log

# Generated from lib/l10n/*.arb by `flutter gen-l10n`. The .arb files are the
# source; committing the output invites the two to drift apart.
lib/l10n/l10n*.dart
docs/show/
